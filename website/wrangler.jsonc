{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "getshelfy-app",
  "compatibility_date": "2026-10-12",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist"
  },
  "routes": [
    { "pattern": "getshelfy.app/*", "zone_name": "getshelfy.app" }
  ]
}
